PROJECT_NAME="AI Adaptive Tourism Companion"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkey-please-change-in-production-use-a-secure-random-token"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (SQLite default for easy setup, or change to PostgreSQL/MySQL)
DATABASE_URL="sqlite:///./tourism_companion.db"
# Example MySQL: mysql+pymysql://user:password@localhost:3306/tourism_companion
# Example PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/tourism_companion

# CORS Settings (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# Optional External API Keys (OpenWeatherMap, Google Places, OpenAI / Gemini, etc.)
OPENWEATHER_API_KEY=""
MAPS_API_KEY=""
AI_API_KEY=""
